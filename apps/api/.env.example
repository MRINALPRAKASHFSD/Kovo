# Backend-specific environment (mirrors root .env.example)
# Prefer setting these in the root .env when running via docker-compose.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://kovo_user:change_me@localhost:5432/kovo_db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
