# ─────────────────────────────────────────────────────────────
# KOVO — Environment Variables Reference
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_NAME=KOVO
APP_VERSION=0.1.0-alpha
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Backend / FastAPI ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_WORKERS=1              # increase for production
LOG_LEVEL=debug                # debug | info | warning | error

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kovo_db
DB_USER=kovo_user
DB_PASSWORD=change_me_in_production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Cache (Redis) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── Auth / JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=super-secret-change-me-in-production-use-256-bit
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kovo.app
SMTP_TLS=true

# ── SMS / OTP ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── S3 Storage ───────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000   # MinIO for local dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=kovo-media
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/kovo-media

# ── WebSocket ────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_MESSAGE_MAX_SIZE=65536

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=KOVO
NEXT_PUBLIC_SENTRY_DSN=

# ── Admin (Next.js) ──────────────────────────────────────────
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
